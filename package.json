{
    "name": "my-vscode-plugin",
    "displayName": "My VSCode Plugin",
    "description": "我的第一个 VSCode 插件",
    "version": "0.8.7",
    "publisher": "wangzhengwei",
    "icon": "images/icon.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/your-username/my-vscode-plugin.git"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./src/extension.js",
    "activationEvents": [
        "onCommand:myPlugin.helloWorld",
        "onCommand:myPlugin.showTime",
        "onCommand:myPlugin.openChart",
        "onCommand:myPlugin.refreshData",
        "onCommand:myPlugin.showTrans",
        "onCommand:myPlugin.smartPick",
        "onCommand:myPlugin.showPredictions",
        "onCommand:myPlugin.maPatterns",
        "onCommand:myPlugin.probabilityPick",
        "onCommand:myPlugin.probabilityBacktest",
        "onCommand:myPlugin.roadAnalysis",
        "onCommand:myPlugin.pl3Formula",
        "onCommand:myPlugin.pl5Formula",
        "onCommand:myPlugin.fc3dFormula",
        "onCommand:myPlugin.smartFilter",
        "onCommand:myPlugin.ssqFilter",
        "onCommand:myPlugin.mlCompare",
        "onCommand:myPlugin.boidsLife",
        "onCommand:myPlugin.boidsNumber",
        "onCommand:myPlugin.toggleTimeBackground",
        "onView:lotteryMenu"
    ],
    "contributes": {
        "commands": [
            {
                "command": "myPlugin.helloWorld",
                "title": "Hello World"
            },
            {
                "command": "myPlugin.showTime",
                "title": "Show Current Time"
            },
            {
                "command": "myPlugin.openChart",
                "title": "Open Trend Chart"
            },
            {
                "command": "myPlugin.refreshData",
                "title": "Refresh Lottery Data"
            },
            {
                "command": "myPlugin.showTrans",
                "title": "Show Transition Stats"
            },
            {
                "command": "myPlugin.smartPick",
                "title": "Smart Pick"
            },
            {
                "command": "myPlugin.showPredictions",
                "title": "Show Predictions"
            },
            {
                "command": "myPlugin.maPatterns",
                "title": "MA Pattern Detection"
            },
            {
                "command": "myPlugin.probabilityPick",
                "title": "Probability Smart Recommendation"
            },
            {
                "command": "myPlugin.probabilityBacktest",
                "title": "Probability Backtest"
            },
                        {
                "command": "myPlugin.roadAnalysis",
                "title": "012路趋势分析"
            },
            {
                "command": "myPlugin.pl3Formula",
                "title": "排列三必背口诀"
            },
            {
                "command": "myPlugin.pl5Formula",
                "title": "排列五口诀"
            },
            {
                "command": "myPlugin.fc3dFormula",
                "title": "福彩3D口诀"
            },
            {
                "command": "myPlugin.smartFilter",
                "title": "大乐透智能精选"
            },
            {
                "command": "myPlugin.ssqFilter",
                "title": "双色球智能精选"
            },
            {
                "command": "myPlugin.mlCompare",
                "title": "ML Model Compare"
            },
            {
                "command": "myPlugin.boidsLife",
                "title": "Boids Life Game"
            },
            {
                "command": "myPlugin.boidsNumber",
                "title": "Boids Number Sim"
            },
            {
                "command": "myPlugin.toggleTimeBackground",
                "title": "Toggle Time Background"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "lottery-explorer",
                    "title": "彩票走势图",
                    "icon": "images/icon.svg"
                }
            ]
        },
        "views": {
            "lottery-explorer": [
                {
                    "id": "lotteryMenu",
                    "name": "功能菜单"
                }
            ]
        },
        "menus": {
            "view/item/context": [],
            "view/title": [
                {
                    "command": "myPlugin.refreshData",
                    "when": "view == lotteryMenu",
                    "group": "navigation"
                }
            ]
        },
        "keybindings": [
            {
                "command": "myPlugin.helloWorld",
                "key": "ctrl+alt+h",
                "mac": "cmd+alt+h"
            }
        ]
    },
    "scripts": {
        "lint": "eslint .",
        "pretest": "npm run lint",
        "test": "node ./test/runTest.js"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.1",
        "@types/vscode": "^1.80.0",
        "@vscode/test-electron": "^2.3.2",
        "@vscode/vsce": "^2.19.0",
        "eslint": "^8.41.0",
        "glob": "^8.1.0",
        "mocha": "^10.2.0",
        "typescript": "^5.1.3"
    }
}
